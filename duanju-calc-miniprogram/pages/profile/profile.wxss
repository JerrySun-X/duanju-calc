/* 会员中心样式 */
.page {
  padding: 24rpx 24rpx 60rpx;
}

/* 头部 */
.pro-hero {
  text-align: center;
  padding: 30rpx 0 20rpx;
}
.pro-hero .crown {
  font-size: 84rpx;
}
.pro-hero .ptitle {
  font-size: 40rpx;
  font-weight: 800;
  margin-top: 12rpx;
}
.pro-hero .psub {
  font-size: 22rpx;
  color: #8A8F99;
  margin-top: 8rpx;
}

/* 已开通状态 */
.pro-active {
  text-align: center;
  background: linear-gradient(135deg, #0E1A12, #12261A);
  border-radius: 28rpx;
  padding: 40rpx 30rpx;
  color: #FFFFFF;
}
.pro-active .pa-emoji {
  font-size: 68rpx;
}
.pro-active .pa-title {
  font-size: 32rpx;
  font-weight: 700;
  margin: 12rpx 0 8rpx;
}
.pro-active .pa-sub {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.65);
  line-height: 1.6;
}
.pro-active .btn-ghost {
  margin-top: 28rpx;
  background: rgba(255, 255, 255, 0.12);
  color: #FFFFFF;
  border: none;
}

/* 价格卡 */
.price-cards {
  display: flex;
  gap: 20rpx;
  margin-bottom: 24rpx;
}
.price-card {
  flex: 1;
  border: 3rpx solid #ECEEF1;
  border-radius: 28rpx;
  padding: 30rpx 16rpx;
  text-align: center;
  position: relative;
  background: #FFFFFF;
}
.price-card.on {
  border-color: #F5A623;
  background: #FFFDF5;
}
.price-card .pvip {
  position: absolute;
  top: -14rpx;
  left: 50%;
  transform: translateX(-50%);
  background: #F54A45;
  color: #FFFFFF;
  font-size: 19rpx;
  padding: 3rpx 16rpx;
  border-radius: 16rpx;
  white-space: nowrap;
}
.price-card .pp {
  font-size: 52rpx;
  font-weight: 800;
}
.price-card .pp .pd-unit {
  font-size: 24rpx;
  font-weight: 400;
}
.price-card .pd {
  font-size: 21rpx;
  color: #8A8F99;
  margin-top: 6rpx;
}
.price-card .psave {
  font-size: 19rpx;
  color: #F54A45;
  margin-top: 6rpx;
  font-weight: 700;
}

/* 权益表 */
.feat-row {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #ECEEF1;
  font-size: 24rpx;
}
.feat-row:last-child {
  border-bottom: none;
}
.feat-head {
  color: #8A8F99;
  font-size: 21rpx;
}
.feat-row .fname {
  flex: 1;
  color: #575D66;
}
.feat-row .ffree,
.feat-row .fpro {
  width: 120rpx;
  text-align: center;
}
.feat-row .yes {
  color: #07C160;
  font-weight: 700;
}
.feat-row .no {
  color: #D5D8DD;
}

/* FAQ */
.faq-item {
  font-size: 22rpx;
  color: #8A8F99;
  line-height: 1.8;
  margin-bottom: 14rpx;
}
.faq-item b {
  color: #575D66;
}

/* 已保存方案 */
.saved-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 18rpx 0;
  border-bottom: 1rpx dashed #ECEEF1;
}
.saved-item:last-child {
  border-bottom: none;
}
.saved-item .sleft {
  flex: 1;
  padding-right: 20rpx;
}
.saved-item .sname {
  font-size: 26rpx;
  font-weight: 600;
}
.saved-item .smeta {
  font-size: 20rpx;
  color: #8A8F99;
  margin-top: 4rpx;
  line-height: 1.5;
}
.saved-item .sprofit {
  font-size: 28rpx;
  font-weight: 700;
  flex-shrink: 0;
}
