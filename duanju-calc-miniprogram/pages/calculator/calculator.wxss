/* 计算器页面样式 */
.page {
  padding: 24rpx 24rpx 60rpx;
}

/* 激励视频解锁条 */
.ad-unlock {
  margin-top: 24rpx;
  background: rgba(255, 216, 107, 0.14);
  border: 1rpx dashed rgba(255, 216, 107, 0.5);
  border-radius: 16rpx;
  padding: 18rpx;
  text-align: center;
  font-size: 24rpx;
  color: #FFD86B;
  font-weight: 600;
}

/* 结果卡 */
.result-card {
  background: linear-gradient(160deg, #0E1A12 0%, #12261A 55%, #0C1F2E 100%);
  color: #FFFFFF;
  border-radius: 32rpx;
  padding: 36rpx 32rpx;
  margin-bottom: 24rpx;
}
.rlabel {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.65);
}
.rnum {
  font-size: 68rpx;
  font-weight: 800;
  margin: 8rpx 0 4rpx;
}
.bonus-line {
  font-size: 24rpx;
  color: #FFD86B;
  margin-top: 8rpx;
  line-height: 1.5;
}
.rgrid {
  display: flex;
  gap: 16rpx;
  margin-top: 28rpx;
}
.rgrid .cell {
  flex: 1;
  background: rgba(255, 255, 255, 0.08);
  border-radius: 20rpx;
  padding: 16rpx 20rpx;
}
.rgrid .cell .k {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.6);
}
.rgrid .cell .v {
  font-size: 30rpx;
  font-weight: 700;
  margin-top: 4rpx;
}

/* 回本线 */
.be-info {
  display: flex;
  justify-content: space-between;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.85);
  margin-bottom: 8rpx;
}
.be-bar {
  height: 20rpx;
  background: rgba(255, 255, 255, 0.12);
  border-radius: 12rpx;
  overflow: hidden;
}
.be-bar .fill {
  height: 100%;
  background: linear-gradient(90deg, #07C160, #34D399);
  border-radius: 12rpx;
  transition: width 0.3s;
}
.be-bar .fill.over {
  background: linear-gradient(90deg, #F54A45, #FF7A45);
}

/* 对比图 */
.cmp-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 18rpx;
}
.cmp-row .cname {
  width: 124rpx;
  font-size: 24rpx;
  color: #575D66;
  flex-shrink: 0;
}
.cmp-row .cbarwrap {
  flex: 1;
  background: #F3F4F6;
  border-radius: 12rpx;
  height: 44rpx;
  overflow: hidden;
}
.cmp-row .cbar {
  height: 100%;
  border-radius: 12rpx;
  transition: width 0.4s ease;
}
.cmp-row .cval {
  width: 172rpx;
  flex-shrink: 0;
  text-align: right;
}
.cmp-row .cval .cb {
  display: block;
  font-size: 24rpx;
  font-weight: 700;
}
.cmp-row .cval .cs {
  display: block;
  font-size: 20rpx;
  color: #8A8F99;
}
.cmp-row.cur .cname {
  color: #07C160;
  font-weight: 700;
}
.cmp-row.cur .cbarwrap {
  outline: 3rpx solid rgba(7, 193, 96, 0.4);
}

/* 已保存方案 */
.saved-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 18rpx 0;
  border-bottom: 1rpx dashed #ECEEF1;
}
.saved-item:last-child {
  border-bottom: none;
}
.saved-item .sleft {
  flex: 1;
  padding-right: 20rpx;
}
.saved-item .sname {
  font-size: 26rpx;
  font-weight: 600;
}
.saved-item .smeta {
  font-size: 20rpx;
  color: #8A8F99;
  margin-top: 4rpx;
  line-height: 1.5;
}
.saved-item .sprofit {
  font-size: 28rpx;
  font-weight: 700;
  flex-shrink: 0;
}

/* 行业基准 */
.bench-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
}
.bench-grid .bcell {
  background: #FAFBFC;
  border: 1rpx solid #ECEEF1;
  border-radius: 20rpx;
  padding: 18rpx 20rpx;
}
.bench-grid .bcell .bv {
  font-size: 32rpx;
  font-weight: 800;
}
.bench-grid .bcell .bl {
  font-size: 20rpx;
  color: #8A8F99;
  margin-top: 2rpx;
}
.bench-grid .bcell .bn {
  font-size: 19rpx;
  color: #8A8F99;
  margin-top: 4rpx;
  line-height: 1.5;
}
